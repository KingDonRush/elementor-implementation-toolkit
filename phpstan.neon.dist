includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 3
    paths:
        - includes/CCT
        - includes/Blueprint
        - includes/Contracts
        - includes/CPT
        - includes/Infrastructure
        - includes/Registry
        - includes/Rest
        - includes/Support/LegacyDomMatcher.php
        - includes/Support/LegacyDomPayload.php
    excludePaths:
        analyse:
            - includes/Rest/FilterPresetEndpoint.php
    treatPhpDocTypesAsCertain: false
